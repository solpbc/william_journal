{"activity": "reading", "created_at": 1752388980000, "day": "20250713", "description": "The sheet, still unfolded", "details": "", "facet": "household", "id": "frame_074000_180", "level_avg": 0.5, "participation": [{"confidence": 0.95, "context": "Looked, and left it.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "screen"}], "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "the sheet still unnamed as to the day", "quote": null, "to": "Anne Shakespeare"}], "segments": ["074000_180"], "story": {"body": "You looked, and you did not fold it. You did not write a day. It stayed where Saturday left it.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "the sheet still unnamed as to the day", "quote": null, "to": "Anne Shakespeare"}], "topics": ["the letter still unfolded", "no day in it"]}, "stream": "desk", "title": "Looked at the letter on the nail", "updated_at": 1752388980000}
{"activity": "social", "created_at": 1752395520000, "day": "20250713", "description": "Two turns, and fourteenthly", "details": "", "facet": "household", "id": "meeting_092000_720", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Refused the mark, and went.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Turned the glass twice, and stopped.", "entity_id": "josias_thwaite", "name": "Master Josias Thwaite", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Counted the turns, and aimed you at dinner.", "entity_id": "dorcas_ansell", "name": "Mistress Dorcas Ansell", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Sat his pew, and added nothing.", "entity_id": "john_spencer", "name": "Sir John Spencer", "role": "visible", "source": "transcript"}], "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "two turns, and a heading", "quote": "And fourteenthly", "to": "Master Josias Thwaite"}], "segments": ["092000_720"], "story": {"body": "You heard the ordinary Sunday, two turns, and the heading. You saw Sir John silent over his book. You refused a cross. You left with Mistress Ansell.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "two turns, and a heading", "quote": "And fourteenthly", "to": "Master Josias Thwaite"}], "topics": ["two turns of the glass", "fourteenthly", "no cross"]}, "stream": "talk", "title": "Stood through two turns of the glass", "updated_at": 1752395520000}
{"activity": "social", "created_at": 1752402960000, "day": "20250713", "description": "The notch stays shut", "details": "", "facet": "household", "id": "meeting_113000_360", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Left both where they were.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Refused a measuring, and called dinner.", "entity_id": "dorcas_ansell", "name": "Mistress Dorcas Ansell", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Left the loaf under the cloth.", "entity_id": "alse_pinder", "name": "Alse Pinder", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "the notch, left shut", "quote": null, "to": "Mistress Dorcas Ansell"}], "segments": ["113000_360"], "story": {"body": "You did not fold the letter. You did not measure the loaf. You sat down to dinner.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "the notch, left shut", "quote": null, "to": "Mistress Dorcas Ansell"}], "topics": ["the letter still on the nail", "the loaf not measured"]}, "stream": "talk", "title": "Sat down to dinner", "updated_at": 1752402960000}
