{"activity": "writing", "created_at": 1758028980000, "day": "20250916", "description": "Her house has not heard", "details": "", "facet": "writing", "id": "frame_142000_180", "level_avg": 0.5, "participation": [{"confidence": 0.95, "context": "Wrote the three lines, and stopped.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "screen"}], "relations": [], "segments": ["142000_180"], "story": {"body": "You wrote the limit of what the page knows. The house on the other side of the square has not been told.", "confidence": 0.95, "relations": [], "topics": ["the square", "her house", "no speech"]}, "stream": "desk", "title": "Wrote the limit of what the page knows", "updated_at": 1758028980000}
