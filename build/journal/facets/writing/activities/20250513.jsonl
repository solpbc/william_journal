{"activity": "writing", "created_at": 1747109640000, "day": "20250513", "description": "Sit, ground, stories", "details": "", "facet": "writing", "id": "frame_051000_240", "level_avg": 0.5, "participation": [{"confidence": 0.95, "context": "Wiped the list and wrote the three words.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "screen"}], "relations": [{"from": "William Shakespeare", "kind": "created", "note": "three words on the tables", "quote": null, "to": "William Shakespeare"}], "segments": ["051000_240"], "story": {"body": "The tables took sit, ground, stories, and nothing else on that leaf.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "created", "note": "three words on the tables", "quote": null, "to": "William Shakespeare"}], "topics": ["three words", "the tables wiped"]}, "stream": "desk", "title": "Wiped the tables and wrote three words", "updated_at": 1747109640000}
{"activity": "writing", "created_at": 1747111560000, "day": "20250513", "description": "The half-sheet, two runs", "details": "", "facet": "writing", "id": "frame_054000_360", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Continued the sheet in two runs.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "screen"}], "relations": [{"from": "William Shakespeare", "kind": "created", "note": "the king's return, continued", "quote": null, "to": "William Shakespeare"}], "segments": ["054000_360"], "story": {"body": "You wrote under Saturday's head, stopped for a long halt, and wrote a second run. The king is late on his own coast.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "created", "note": "the king's return, continued", "quote": null, "to": "William Shakespeare"}], "topics": ["the half-sheet continued", "two runs", "the coast of Wales"]}, "stream": "desk", "title": "Continued the half-sheet in two runs", "updated_at": 1747111560000}
{"activity": "reading", "created_at": 1747118040000, "day": "20250513", "description": "Two books at the same place", "details": "", "facet": "writing", "id": "frame_073000_240", "level_avg": 0.5, "participation": [{"confidence": 0.95, "context": "Read the two openings against each other, and copied nothing.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "screen"}], "relations": [{"from": "William Shakespeare", "kind": "uses", "note": "the chronicle is still the volume he lent, and it is open here", "quote": null, "to": "Richard Field"}], "segments": ["073000_240"], "story": {"body": "Holinshed and Daniel lay open at Richard's return from Ireland. You took no sentence onto the sheet.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "uses", "note": "the chronicle is still the volume he lent, and it is open here", "quote": null, "to": "Richard Field"}], "topics": ["Holinshed", "Daniel", "the return from Ireland"]}, "stream": "desk", "title": "Read Holinshed and Daniel at Richard's return from Ireland", "updated_at": 1747118040000}
