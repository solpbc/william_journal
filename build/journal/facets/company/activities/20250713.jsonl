{"activity": "social", "created_at": 1752430440000, "day": "20250713", "description": "A shilling for the mutton", "details": "", "facet": "company", "id": "meeting_190000_840", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Named the shilling, and listened.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Ate, and made the sprites almost nothing.", "entity_id": "thomas_nashe", "name": "Thomas Nashe", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "one shilling, and the wagon-spokes", "quote": "Spokes of a gnat's wagon.", "to": "Thomas Nashe"}], "segments": ["190000_840"], "story": {"body": "You paid for the mutton and the cup. You let him run at Harvey, at the thumb-rings, and at the three small things. You did not write at the table.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "one shilling, and the wagon-spokes", "quote": "Spokes of a gnat's wagon.", "to": "Thomas Nashe"}], "topics": ["a shilling supper", "Harvey", "thumb-rings", "the size of the sprites"]}, "stream": "talk", "title": "Paid Nashe's shilling and heard the sprites made small", "updated_at": 1752430440000}
{"activity": "social", "created_at": 1752432480000, "day": "20250713", "description": "A garden, and then something else", "details": "", "facet": "company", "id": "meeting_194000_480", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Stopped the garden at the laugh.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Went quiet, and then went fast.", "entity_id": "thomas_nashe", "name": "Thomas Nashe", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "a garden, and then not", "quote": "Two summers gone.", "to": "Thomas Nashe"}], "segments": ["194000_480"], "story": {"body": "You heard Kit laughing in a garden at Scadbury, two summers gone. You did not ask for the rest. He was already talking of something else.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "a garden, and then not", "quote": "Two summers gone.", "to": "Thomas Nashe"}], "topics": ["the third cup", "Scadbury", "the fast swerve"]}, "stream": "talk", "title": "Heard of Kit laughing at Scadbury", "updated_at": 1752432480000}
{"activity": "social", "created_at": 1752437040000, "day": "20250713", "description": "Behind the eyes", "details": "", "facet": "company", "id": "meeting_210000_240", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Named the gnats, and went.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Asked where, and let the fourth pint go.", "entity_id": "thomas_nashe", "name": "Thomas Nashe", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "the pain, and the hour", "quote": "Behind the eyes.", "to": "Thomas Nashe"}], "segments": ["210000_240"], "story": {"body": "You stopped the supper at nine. You named the place of the pain. You did not stay for another pint.", "confidence": 0.95, "relations": [{"from": "William Shakespeare", "kind": "knows", "note": "the pain, and the hour", "quote": "Behind the eyes.", "to": "Thomas Nashe"}], "topics": ["the pain", "behind the eyes", "the gnats"]}, "stream": "talk", "title": "Pleaded a pain in the head and went", "updated_at": 1752437040000}
