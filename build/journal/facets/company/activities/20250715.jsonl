{"activity": "meeting", "created_at": 1752567240000, "day": "20250715", "description": "The king at nine", "details": "", "facet": "company", "id": "meeting_091000_240", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Stayed in the king, and kept the sheets back.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Refused a new sentence.", "entity_id": "richard_burbage", "name": "Richard Burbage", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Said you, and stopped.", "entity_id": "will_kemp", "name": "Will Kemp", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Separated the hour from the dinner.", "entity_id": "john_heminges", "name": "John Heminges", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "Will Kemp", "kind": "works-with", "note": "the king, and the old you", "quote": "You.", "to": "William Shakespeare"}], "segments": ["091000_240"], "story": {"body": "You took your place in the morning's king. You did not read the dinner's sheets into it. Kemp left the old \"you\" as it was.", "confidence": 0.95, "relations": [{"from": "Will Kemp", "kind": "works-with", "note": "the king, and the old you", "quote": "You.", "to": "William Shakespeare"}], "topics": ["the morning king", "you are in it", "the sheets kept back"]}, "stream": "talk", "title": "Rehearsed the king and kept the sheets sleeved", "updated_at": 1752567240000}
{"activity": "social", "created_at": 1752575520000, "day": "20250715", "description": "Sixpence, and the pig", "details": "", "facet": "company", "id": "meeting_112000_720", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Read the two sheets fast.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Heard it, and said again.", "entity_id": "augustine_phillips", "name": "Augustine Phillips", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Waited for his word.", "entity_id": "richard_burbage", "name": "Richard Burbage", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Stopped chewing at the pig.", "entity_id": "thomas_pope", "name": "Thomas Pope", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Forgot the message.", "entity_id": "sam_latchet", "name": "Sam Latchet", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Kept the sixpence honest and the mutton small.", "entity_id": "agnes_tipping", "name": "Agnes Tipping", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "Augustine Phillips", "kind": "works-with", "note": "the speech, and the one word again", "quote": "Again.", "to": "William Shakespeare"}], "segments": ["112000_720"], "story": {"body": "You spent the sixpence on a smaller plate and a fast reading. Pope stopped at the pig. Sam lost the message. Phillips asked for it again in one word.", "confidence": 0.95, "relations": [{"from": "Augustine Phillips", "kind": "works-with", "note": "the speech, and the one word again", "quote": "Again.", "to": "William Shakespeare"}], "topics": ["sixpence", "the smaller mutton", "the fast reading", "the pig"]}, "stream": "talk", "title": "Read the two sheets fast until Phillips said again", "updated_at": 1752575520000}
{"activity": "social", "created_at": 1752577320000, "day": "20250715", "description": "Peace, once", "details": "", "facet": "company", "id": "meeting_115000_720", "level_avg": 1.0, "participation": [{"confidence": 0.95, "context": "Read slower, and measured the one word.", "entity_id": "william_shakespeare", "name": "William Shakespeare", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Fitted the tenth line, and refused a third reading.", "entity_id": "augustine_phillips", "name": "Augustine Phillips", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Accepted Peace, once.", "entity_id": "richard_burbage", "name": "Richard Burbage", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Let the second pig pass without a rite.", "entity_id": "thomas_pope", "name": "Thomas Pope", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Still had no message.", "entity_id": "sam_latchet", "name": "Sam Latchet", "role": "attendee", "source": "speaker_label"}, {"confidence": 0.95, "context": "Feared the alderman, and kept the sixpence.", "entity_id": "agnes_tipping", "name": "Agnes Tipping", "role": "attendee", "source": "speaker_label"}], "relations": [{"from": "Richard Burbage", "kind": "works-with", "note": "one word, and it is enough", "quote": "It's enough.", "to": "William Shakespeare"}], "segments": ["115000_720"], "story": {"body": "You gave Phillips the second pass. You gave Burbage Peace, once. Agnes said an alderman would have you shut. You left the notes as notes and took the sheets home.", "confidence": 0.95, "relations": [{"from": "Richard Burbage", "kind": "works-with", "note": "one word, and it is enough", "quote": "It's enough.", "to": "William Shakespeare"}], "topics": ["the slower reading", "Peace once", "the alderman"]}, "stream": "talk", "title": "Read it slower and gave Burbage Peace, once", "updated_at": 1752577320000}
