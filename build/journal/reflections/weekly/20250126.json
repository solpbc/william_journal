  "memories": [
    {
      "id": "m-20250126-0",
      "key": "mem_20250126_0",
      "day": "20250126",
      "text": "The sermon reached fourteenthly, and the sand-glass was turned twice. A finger short at dinner. At Holywell a wedding wants paying for.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250126/talents/morning_briefing",
        "briefing_day": "20250126",
        "refs": [
          "sol://facets/household/activities/20250126#meeting_092000_480",
          "sol://facets/household/activities/20250126#meeting_122000_480",
          "sol://facets/company/activities/20250126#meeting_181000_840"
        ]
      }
    },
    {
      "id": "m-20250127-1",
      "key": "mem_20250127_1",
      "day": "20250127",
      "text": "Twopence the horn. You began a leaf and dated it in the old year. John counted the ladies. The Princess wants a gown.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250127/talents/morning_briefing",
        "briefing_day": "20250127",
        "refs": [
          "sol://facets/household/activities/20250127#meeting_084000_360",
          "sol://facets/writing/activities/20250127#note_112000_480",
          "sol://facets/company/activities/20250127#call_191500_240"
        ]
      }
    },
    {
      "id": "m-20250128-2",
      "key": "mem_20250128_2",
      "day": "20250128",
      "text": "You read the book, and Abel had copied. Costard was read badly on purpose. The Princess governs.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250128/talents/morning_briefing",
        "briefing_day": "20250128",
        "refs": [
          "sol://facets/company/activities/20250128#meeting_091000_960",
          "sol://facets/company/activities/20250128#frame_114000_180",
          "sol://facets/household/activities/20250128#memo_123000_120"
        ]
      }
    },
    {
      "id": "m-20250129-3",
      "key": "mem_20250129_3",
      "day": "20250129",
      "text": "You wrote Augustine a pointing. Under the stage, one cry. Think of the reckoning. You were more fearful a fortnight ago.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250129/talents/morning_briefing",
        "briefing_day": "20250129",
        "refs": [
          "sol://facets/company/activities/20250129#note_083000_360",
          "sol://facets/household/activities/20250129#memo_132000_120",
          "sol://facets/company/activities/20250129#frame_162000_120"
        ]
      }
    },
    {
      "id": "m-20250130-4",
      "key": "mem_20250130_4",
      "day": "20250130",
      "text": "The pointing went into Augustine's hand at nine. The twentieth of February, and a stop on Shrove Tuesday. A comedy needs no jig. The day for Anne is still not known.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250130/talents/morning_briefing",
        "briefing_day": "20250130",
        "refs": [
          "sol://facets/company/activities/20250130#meeting_091000_480",
          "sol://facets/company/activities/20250130#frame_140500_120",
          "sol://facets/company/activities/20250130#meeting_170500_840"
        ]
      }
    },
    {
      "id": "m-20250131-5",
      "key": "mem_20250131_5",
      "day": "20250131",
      "text": "You wrote a second leaf, dated the last of January. The loaf wants a finger. You did not write the packet.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250131/talents/morning_briefing",
        "briefing_day": "20250131",
        "refs": [
          "sol://facets/writing/activities/20250131#note_104000_480",
          "sol://facets/household/activities/20250131#meeting_123000_360",
          "sol://facets/stratford/activities/20250131#memo_211000_120"
        ]
      }
    },
    {
      "id": "m-20250201-6",
      "key": "mem_20250201_6",
      "day": "20250201",
      "text": "Fifteen barges, and an oar lifted clear. Done for a penny, and rogues by statute.",
      "source": {
        "kind": "briefing",
        "uri": "sol://chronicle/20250201/talents/morning_briefing",
        "briefing_day": "20250201",
        "refs": [
          "sol://facets/company/activities/20250201#meeting_103500_360",
          "sol://facets/company/activities/20250201#meeting_112000_720",
          "sol://facets/company/activities/20250201#photo_113200_120"
        ]
      }
    }
  ],
  "said": [
    {
      "id": "s-20250126-0",
      "key": "said_20250126_0",
      "day": "20250126",
      "quote": "A wedding wants a play as a feast wants a fool, Dick. Something light to get the company to bed.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/company/activities/20250126#meeting_181000_840"
      }
    },
    {
      "id": "s-20250126-1",
      "key": "said_20250126_1",
      "day": "20250126",
      "quote": "Nothing written down. The sentence died between Holywell and the close, as I told Dick it would.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/writing/activities/20250126#memo_214000_120"
      }
    },
    {
      "id": "s-20250127-2",
      "key": "said_20250127_2",
      "day": "20250127",
      "quote": "Let him stay. I have a leaf to begin, and no name to put at the head of it.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/household/activities/20250127#meeting_084000_360"
      }
    },
    {
      "id": "s-20250128-3",
      "key": "said_20250128_3",
      "day": "20250128",
      "quote": "No. She governs.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/company/activities/20250128#meeting_091000_960"
      }
    },
    {
      "id": "s-20250129-4",
      "key": "said_20250129_4",
      "day": "20250129",
      "quote": "It was not a joke. Think of the reckoning when you want the body to stop explaining itself. The cry is one line. It does not need a second.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/company/activities/20250129#meeting_164500_720"
      }
    },
    {
      "id": "s-20250130-5",
      "key": "said_20250130_5",
      "day": "20250130",
      "quote": "Sir John sits three rows ahead of me on a Sunday. I am not handing him a playing Thursday after the ash.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/company/activities/20250130#meeting_170500_840"
      }
    },
    {
      "id": "s-20250201-6",
      "key": "said_20250201_6",
      "day": "20250201",
      "quote": "A student playing a prince, and the Tower's guns answer him as if it were so.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/writing/activities/20250201#memo_114800_120"
      }
    },
    {
      "id": "s-20250201-7",
      "key": "said_20250201_7",
      "day": "20250201",
      "quote": "We do it for a penny and are rogues by statute.",
      "source": {
        "kind": "activity",
        "uri": "sol://facets/writing/activities/20250201#memo_114800_120"
      }
    }
  ]
}
